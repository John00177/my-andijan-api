# Every value here is a non-secret placeholder. Never put a real credential in
# this file — .gitignore excludes .env and .env.* but deliberately NOT this file.

# Local development only. The user/password below intentionally match
# POSTGRES_USER / POSTGRES_PASSWORD in docker-compose.yml so that
# `docker compose up -d` then `npx prisma migrate dev` works with no edits.
# Production uses the managed connection string instead.
DATABASE_URL="postgresql://andijan:andijan_dev_password@localhost:5432/my_andijan?schema=public"

# Generate your own; never ship these strings. e.g. openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000

# Used only by `npm run db:seed` to create the first ADMIN. Replace the password
# placeholder with a strong value before seeding — prisma/seed.ts has no fallback
# and will refuse to run while it is unset, so an unconfigured seed can never
# create an admin whose password is published in this repository.
SEED_ADMIN_PHONE="+998900000000"
SEED_ADMIN_PASSWORD="<set-a-strong-password-before-seeding>"
SEED_ADMIN_EMAIL="admin@myandijan.uz"
