# Every value here is a non-secret placeholder. Never put a real credential in
# this file — .gitignore excludes .env and .env.* but deliberately NOT this file.

# Local development only. The user/password below intentionally match
# POSTGRES_USER / POSTGRES_PASSWORD in docker-compose.yml so that
# `docker compose up -d` then `npx prisma migrate dev` works with no edits.
# Production uses the managed connection string instead.
DATABASE_URL="postgresql://andijan:andijan_dev_password@localhost:5432/my_andijan?schema=public"

# Generate your own; never ship these strings. e.g. openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000

# Used only by `npm run db:seed` to create the first ADMIN. Replace the password
# placeholder with a strong value before seeding — prisma/seed.ts has no fallback
# and will refuse to run while it is unset, so an unconfigured seed can never
# create an admin whose password is published in this repository.
SEED_ADMIN_PHONE="+998900000000"
SEED_ADMIN_PASSWORD="<set-a-strong-password-before-seeding>"
SEED_ADMIN_EMAIL="admin@myandijan.uz"

# Used only by scripts/seed-role-accounts.js (one account per role tier). No
# default: the script refuses to run while this is empty.
SEED_ROLE_PASSWORD=""

# Image uploads (src/upload/upload.service.ts). REQUIRED to boot: UploadService
# checks both in its constructor and AuthService depends on it, so the API will
# not start while either is empty. For local work point them at your own
# Supabase project. SUPABASE_SERVICE_KEY is the service_role key — it bypasses
# Row Level Security, so it stays server-side and never gets a VITE_ name.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# SMS via Eskiz.uz (src/sms/sms.service.ts). While EMAIL or PASSWORD is empty,
# OTP sign-in and SMS password reset fail closed with 503 — fine for local work.
# ESKIZ_FROM is optional (sender id, sent only when set).
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM=""
# Optional override, read with `??`: leave it commented out — an empty value
# would replace the default https://notify.eskiz.uz/api with "".
# ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
